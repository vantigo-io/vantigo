<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <AssemblyName>Vantigo.Host</AssemblyName>
    <RootNamespace>Vantigo.Host</RootNamespace>

    <EnableSdkContainerSupport>true</EnableSdkContainerSupport>
    <PublishProfile>DefaultContainer</PublishProfile>
    <ContainerRepository>vantigo-io/vantigo</ContainerRepository>
    <!-- The chiseled base provides the unprivileged 'app' user (UID 1654);
         setting it explicitly makes non-root a stated guarantee CI asserts
         instead of an inherited default a base-image change could undo. -->
    <ContainerUser>app</ContainerUser>
    <ContainerPort>8080</ContainerPort>
    <RuntimeIdentifiers>linux-x64;linux-arm64</RuntimeIdentifiers>
    <ContainerRuntimeIdentifiers>linux-x64;linux-arm64</ContainerRuntimeIdentifiers>
    <ContainerPublishInParallel>false</ContainerPublishInParallel>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Asp.Versioning.Http" />
    <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" />
    <PackageReference Include="Asp.Versioning.OpenApi" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Npgsql.OpenTelemetry" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
    <PackageReference Include="MailKit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\packages\configuration\Vantigo.Configuration\Vantigo.Configuration.csproj" />
    <ProjectReference Include="..\..\..\..\packages\azure-identity\Vantigo.Azure.Identity\Vantigo.Azure.Identity.csproj" />
    <ProjectReference Include="..\..\..\..\packages\contracts\Vantigo.Contracts.AspNetCore\Vantigo.Contracts.AspNetCore.csproj" />
    <ProjectReference Include="..\..\..\..\packages\dataprotection-postgresql\Vantigo.DataProtection.PostgreSql\Vantigo.DataProtection.PostgreSql.csproj" />
    <ProjectReference Include="..\..\..\..\packages\storage\Vantigo.Storage\Vantigo.Storage.csproj" />
    <ProjectReference Include="..\..\..\..\packages\tenancy\Vantigo.Tenancy\Vantigo.Tenancy.csproj" />
    <ProjectReference Include="..\..\..\identity\backend\Identity.Module\Identity.Module.csproj" />
    <ProjectReference Include="..\..\..\..\apps\customers\backend\Customers.Module\Customers.Module.csproj" />
    <ProjectReference Include="..\..\..\..\apps\communications\backend\Communications.Module\Communications.Module.csproj" />
    <ProjectReference Include="..\..\..\..\apps\products\backend\Products.Module\Products.Module.csproj" />
    <ProjectReference Include="..\..\..\..\apps\energy\backend\Energy.Module\Energy.Module.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <FrontendRoot>$(MSBuildProjectDirectory)/../../frontend</FrontendRoot>
  </PropertyGroup>

  <Target Name="BuildFrontend" BeforeTargets="ComputeFilesToPublish">
    <Exec Command="bun run build" WorkingDirectory="$(FrontendRoot)" />
    <ItemGroup>
      <FrontendDistFiles Include="$(FrontendRoot)/dist/**" />
      <ResolvedFileToPublish Include="@(FrontendDistFiles)">
        <RelativePath>wwwroot/%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
