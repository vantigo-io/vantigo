<!DOCTYPE html>
<html lang="{{.Lang}}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Subject}}</title>
</head>
<body style="margin:0;padding:24px;background-color:#ffffff;color:#1f2328;font-family:Arial,Helvetica,sans-serif;font-size:15px;line-height:1.5">
<div style="max-width:600px">
{{- if .Logo}}
<p style="margin:0 0 24px"><img src="cid:logo" alt="{{.Seller}}" style="max-height:60px"></p>
{{- end}}
<p style="margin:0 0 16px">{{.Greeting}}</p>
{{- if .Message}}
<p style="margin:0 0 16px">{{range $i, $line := .Message}}{{if $i}}<br>{{end}}{{$line}}{{end}}</p>
{{- end}}
{{- range .Paragraphs}}
<p style="margin:0 0 16px">{{.}}</p>
{{- end}}
{{- if .PayURL}}
<p style="margin:0 0 16px">{{.PayLead}} <a href="{{.PayURL}}" style="color:#0b57d0">{{.PayURL}}</a></p>
{{- end}}
<p style="margin:24px 0 0">{{.Closing}}<br>{{.Seller}}</p>
</div>
</body>
</html>
