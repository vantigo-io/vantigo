# Local development environment variables for `apps/server`.
# Note: `mise run server:dev` and `mise run server:seed` set these automatically.
# Copy or source this file when running `go run ./cmd/vantigo` directly from your IDE or terminal.

APP_ENV=development
APP_URL=http://localhost:8080
PORT=8080
LOG_LEVEL=debug

# Connects to the local dev Postgres container started by `mise run server:db` (docker-compose.dev.yml).
DATABASE_URL=postgres://vantigo:vantigo@127.0.0.1:55433/vantigo?sslmode=disable

# 32+ byte secret used to seal session cookies and encrypted credentials in local development.
APP_SECRET=dev-only-app-secret-not-for-production-use

# Optional: log outbound emails to stdout in development ("log" is the default when APP_ENV=development).
MAIL_DRIVER=log
