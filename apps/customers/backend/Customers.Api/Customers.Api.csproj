<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <AssemblyName>Vantigo.Customers.Api</AssemblyName>
    <RootNamespace>Vantigo.Customers.Api</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Asp.Versioning.Http" />
    <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" />
    <PackageReference Include="Asp.Versioning.OpenApi" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Database\Migrations\" />
  </ItemGroup>

  <!--
    On publish, build the SPA and embed it into wwwroot so the API serves the frontend
    from "/" in production. Plain `dotnet build`/`dotnet run` never touches the frontend;
    development uses the Vite dev server with an /api proxy instead.
  -->
  <PropertyGroup>
    <FrontendRoot>$(MSBuildProjectDirectory)/../../frontend</FrontendRoot>
  </PropertyGroup>

  <Target Name="BuildFrontend" BeforeTargets="ComputeFilesToPublish">
    <Exec Command="bun install --frozen-lockfile" WorkingDirectory="$(FrontendRoot)/../../.." />
    <Exec Command="bun run build" WorkingDirectory="$(FrontendRoot)" />

    <ItemGroup>
      <FrontendDistFiles Include="$(FrontendRoot)/dist/**" />
      <ResolvedFileToPublish Include="@(FrontendDistFiles)">
        <RelativePath>wwwroot/%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
