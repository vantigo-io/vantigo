<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <AssemblyName>Vantigo.Customers.Api</AssemblyName>
    <RootNamespace>Vantigo.Customers.Api</RootNamespace>

    <EnableSdkContainerSupport>true</EnableSdkContainerSupport>
    <PublishProfile>DefaultContainer</PublishProfile>
    <ContainerRepository>vantigo-io/customers</ContainerRepository>
    <ContainerPort>8080</ContainerPort>
    <RuntimeIdentifiers>linux-x64;linux-arm64</RuntimeIdentifiers>
    <ContainerRuntimeIdentifiers>linux-x64;linux-arm64</ContainerRuntimeIdentifiers>
    <ContainerPublishInParallel>false</ContainerPublishInParallel>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Asp.Versioning.Http" />
    <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" />
    <PackageReference Include="Asp.Versioning.OpenApi" />
    <PackageReference Include="Bogus" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="MailKit" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\packages\hosting\Vantigo.Hosting\Vantigo.Hosting.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Database\Customers\Migrations\" />
    <Folder Include="Database\Accounts\Migrations\" />
  </ItemGroup>

  <!--
    On publish, build the SPA and embed it into wwwroot so the API serves the frontend
    from "/" in production. Plain `dotnet build`/`dotnet run` never touches the frontend;
    development uses the Vite dev server with an /api proxy instead.
  -->
  <PropertyGroup>
    <FrontendRoot>$(MSBuildProjectDirectory)/../../frontend</FrontendRoot>
  </PropertyGroup>

  <Target Name="BuildFrontend" BeforeTargets="ComputeFilesToPublish">
    <Exec Command="bun run build" WorkingDirectory="$(FrontendRoot)" />

    <ItemGroup>
      <FrontendDistFiles Include="$(FrontendRoot)/dist/**" />
      <ResolvedFileToPublish Include="@(FrontendDistFiles)">
        <RelativePath>wwwroot/%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
