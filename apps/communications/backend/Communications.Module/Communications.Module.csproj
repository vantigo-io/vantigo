<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Vantigo.Communications</AssemblyName>
    <RootNamespace>Vantigo.Communications</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Asp.Versioning.Http" />
    <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" />
    <PackageReference Include="Asp.Versioning.OpenApi" />
    <PackageReference Include="Bogus" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="MailKit" />
    <!-- HtmlSanitizer is the NuGet package that provides Ganss.Xss.HtmlSanitizer.
         Keep the project dependency explicit so CPM's version is preserved when
         this module is referenced by architecture/test projects. -->
    <PackageReference Include="HtmlSanitizer" VersionOverride="9.2.995" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\packages\configuration\Vantigo.Configuration\Vantigo.Configuration.csproj" />
    <ProjectReference Include="..\..\..\..\packages\contracts\Vantigo.Contracts\Vantigo.Contracts.csproj" />
    <ProjectReference Include="..\..\..\..\packages\contracts\Vantigo.Contracts.AspNetCore\Vantigo.Contracts.AspNetCore.csproj" />
    <ProjectReference Include="..\..\..\..\packages\storage\Vantigo.Storage.Abstractions\Vantigo.Storage.Abstractions.csproj" />
    <ProjectReference Include="..\..\..\..\packages\tenancy\Vantigo.Tenancy.Abstractions\Vantigo.Tenancy.Abstractions.csproj" />
    <ProjectReference Include="..\..\..\..\packages\tenancy\Vantigo.Tenancy.EntityFramework\Vantigo.Tenancy.EntityFramework.csproj" />
    <ProjectReference Include="..\..\..\..\packages\tenancy\Vantigo.Tenancy\Vantigo.Tenancy.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Database\Communications\Migrations\" />
  </ItemGroup>

  <!-- A published build can contain a separately built SPA. The target is deliberately
       conditional: the API remains a standalone backend when that frontend is absent. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
</Project>
