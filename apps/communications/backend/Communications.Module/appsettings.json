{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "App": {
    "BasePath": "/communications"
  },
  "Outbox": {
    "PollSeconds": 5,
    "LeaseSeconds": 60,
    "MaxAttempts": 8
  },
  "Smtp": {
    "Host": "smtp.example.invalid",
    "Port": 587,
    "Username": "",
    "Password": "",
    "UseSsl": false,
    "TimeoutSeconds": 20,
    "AllowInsecurePlaintext": false
  },
  "Communications": {
    "Scanner": {
      "Host": "",
      "Port": 3310,
      "ConnectTimeoutSeconds": 3,
      "ScanTimeoutSeconds": 30,
      "MaxBytes": 10485760,
      "MaxAttempts": 5,
      "PollSeconds": 5
    },
    "BootstrapMailbox": {
      "Enabled": false,
      "FromAddress": "",
      "DisplayName": ""
    },
    "Retention": {
      "Days": 365,
      "BatchSize": 100,
      "PollMinutes": 60
    },
    "Smtp": {
      "AllowedHosts": [],
      "AllowPrivateNetworks": false
    }
  }
}
