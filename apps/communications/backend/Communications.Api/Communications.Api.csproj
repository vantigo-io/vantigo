<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <AssemblyName>Vantigo.Communications.Api</AssemblyName>
    <RootNamespace>Vantigo.Communications.Api</RootNamespace>

    <EnableSdkContainerSupport>true</EnableSdkContainerSupport>
    <PublishProfile>DefaultContainer</PublishProfile>
    <ContainerRepository>vantigo-io/communications</ContainerRepository>
    <ContainerPort>8080</ContainerPort>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Asp.Versioning.Http" />
    <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" />
    <PackageReference Include="Asp.Versioning.OpenApi" />
    <PackageReference Include="Bogus" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="MailKit" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Database\Communications\Migrations\" />
    <Folder Include="Database\Accounts\Migrations\" />
  </ItemGroup>

  <!-- A published build can contain a separately built SPA. The target is deliberately
       conditional: the API remains a standalone backend when that frontend is absent. -->
  <PropertyGroup>
    <FrontendRoot>$(MSBuildProjectDirectory)/../../frontend</FrontendRoot>
  </PropertyGroup>
  <Target Name="BuildFrontend" BeforeTargets="ComputeFilesToPublish" Condition="Exists('$(FrontendRoot)')">
    <Exec Command="bun run build" WorkingDirectory="$(FrontendRoot)" />
    <ItemGroup>
      <FrontendDistFiles Include="$(FrontendRoot)/dist/**" />
      <ResolvedFileToPublish Include="@(FrontendDistFiles)">
        <RelativePath>wwwroot/%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
