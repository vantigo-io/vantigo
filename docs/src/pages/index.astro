---
// The site root. Starlight serves every page under a locale prefix (/en/, /nb/)
// and generates no root page of its own, so this one sends the reader to the
// language their browser prefers: Norwegian for a Norwegian browser, English
// otherwise. The meta refresh is the fallback without JavaScript.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content="0; url=/en/" />
    <link rel="canonical" href="/en/" />
    <title>Vantigo documentation</title>
    <script is:inline>
      const languages = navigator.languages ?? [navigator.language ?? "en"];
      const norwegian = languages.some((l) => /^(nb|nn|no)\b/i.test(l));
      location.replace(norwegian ? "/nb/" : "/en/");
    </script>
  </head>
  <body>
    <p><a href="/en/">Vantigo documentation (English)</a> · <a href="/nb/">Vantigo-dokumentasjon (norsk)</a></p>
  </body>
</html>
