  <ItemGroup>
    <ProjectReference Include="..\..\azure-identity\Vantigo.Azure.Identity\Vantigo.Azure.Identity.csproj" />
    <ProjectReference Include="..\..\configuration\Vantigo.Configuration\Vantigo.Configuration.csproj" />
  </ItemGroup>

</Project>
