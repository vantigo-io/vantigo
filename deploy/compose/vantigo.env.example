# Vantigo application settings.
# Copy this file to `vantigo.env` and adjust the values.
# Full reference: https://github.com/vantigo-io/vantigo/blob/main/docs/customers-authentication.md

# --- Application and database ------------------------------------------------
# Compose supplies ConnectionStrings__vantigo for the shared PostgreSQL database.
# The host application defaults to the domain root; set a path when the whole
# application is mounted below a reverse-proxy prefix.
ConnectionStrings__vantigo=Host=postgres;Database=vantigo;Username=vantigo;Password=change-me
App__PublicOrigin=http://localhost:8080
App__BasePath=

# --- First-owner bootstrap ----------------------------------------------------
# Optional. If unset, a one-time secret is generated at startup and printed
# once in the container logs (`docker compose logs vantigo`). Visit /setup to
# create the first Owner account, then remove or rotate this secret.
# Authentication__Bootstrap__Secret=

# --- Identity and authentication ---------------------------------------------
# Require TOTP MFA for Owner accounts.
# Authentication__Owners__RequireMfa=true
# Authentication__Owners__MfaIssuer=Vantigo
# Authentication__Invitations__Lifetime=7.00:00:00
# Authentication__Invitations__AcceptUrl=https://vantigo.example.com/invitations/accept?token={token}
# Authentication__PasswordReset__ResetUrl=https://vantigo.example.com/password-reset?email={email}&token={token}

# Legacy optional workforce OIDC (one startup-configured provider). Supplying any
# of Authority, ClientId or ClientSecret enables strict validation of all three.
# Persisted multi-provider SSO is owner-managed and uses dynamic federation routes;
# its clientSecretReference must point to an exact VANTIGO_SSO_*_CLIENT_SECRET
# environment variable injected separately by the deployment.
# Authentication__Oidc__Authority=https://issuer.example.com
# Authentication__Oidc__ClientId=
# Authentication__Oidc__ClientSecret=
# Authentication__Oidc__DisplayName=Workforce SSO
# Authentication__Oidc__CallbackPath=/api/v1/identity/oidc/callback

# --- SCIM provisioning ---------------------------------------------------------
# SCIM uses /api/v1/identity/scim/v2 and bearer tokens. The reference must name
# the exact environment variable holding the pepper; do not put the pepper here.
# Authentication__Scim__TokenPepperReference=VANTIGO_SCIM_DIRECTORY_TOKEN_PEPPER
# VANTIGO_SCIM_DIRECTORY_TOKEN_PEPPER=<inject-from-secret-store>

# --- Application email (identity invitations and password recovery) -----------
# `Logging` writes email contents to container logs and is suitable only for
# local/pre-production use. Set `Smtp` and provide real credentials in a secret
# store for production.
# Email__Provider=Smtp
# Email__From=no-reply@example.com
# Email__Smtp__Host=smtp.example.com
# Email__Smtp__Port=587
# Email__Smtp__UserName=
# Email__Smtp__Password=
# Email__Smtp__EnableSsl=true
# Email__Smtp__TimeoutSeconds=30

# --- Communications delivery -------------------------------------------------
# The communications module's default mailbox delivery uses these Smtp:* keys.
# Mailgun credentials are configured per mailbox through the communications API
# (`provider`, `domain`, `region` and `apiKey`); there are no global Mailgun
# environment variables in the host configuration.
# Smtp__Host=smtp.example.com
# Smtp__Port=587
# Smtp__Username=
# Smtp__Password=
# Smtp__UseSsl=false
# Smtp__TimeoutSeconds=20
# Smtp__AllowInsecurePlaintext=false
# Communications__BootstrapMailbox__Enabled=false
# Communications__BootstrapMailbox__FromAddress=no-reply@example.com
# Communications__BootstrapMailbox__DisplayName=Vantigo
# Communications__Retention__Days=365
# Communications__Retention__BatchSize=100
# Communications__Retention__PollMinutes=60

# --- Module switches ----------------------------------------------------------
Modules__Customers__Enabled=true
Modules__Communications__Enabled=true
Modules__Products__Enabled=true

# --- Reverse proxy ------------------------------------------------------------
# When running behind a TLS-terminating reverse proxy, trust exactly that
# proxy so forwarded scheme/host values are honored.
# ForwardedHeaders__KnownProxies=10.0.0.10
# ForwardedHeaders__KnownNetworks__0=10.0.0.0/24

# --- Observability ------------------------------------------------------------
# OpenTelemetry traces, metrics and logs. Off unless an OTLP endpoint is set.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
# OTEL_EXPORTER_OTLP_PROTOCOL=grpc
# OTEL_EXPORTER_OTLP_HEADERS=x-api-key=secret
