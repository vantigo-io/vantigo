# Shared settings for the Vantigo Docker Compose stack.
# Copy this file to `.env` and adjust the values.

# Image tag to run. `latest` tracks the newest release; pin a version
# (for example `v1.2.3`) for reproducible deployments.
VANTIGO_TAG=latest

# PostgreSQL credentials used by all applications.
POSTGRES_USER=vantigo
POSTGRES_PASSWORD=change-me

# Host ports the applications are published on.
CUSTOMERS_PORT=8080
COMMUNICATIONS_PORT=8081
PRODUCTS_PORT=8082
