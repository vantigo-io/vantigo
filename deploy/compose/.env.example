# Shared settings for the Vantigo Docker Compose stack.
# Copy this file to `.env` and adjust the values.

# Image tag to run. `latest` tracks the newest release; pin a version
# (for example `0.16.1` — no leading `v`; that prefix is kept only on git
# tags, not on the published image tags) for reproducible deployments.
VANTIGO_TAG=latest

# PostgreSQL owner role. It owns the schemas and runs the migration job.
POSTGRES_USER=vantigo
POSTGRES_PASSWORD=change-me

# Least-privilege runtime role created on first database initialization:
# NOSUPERUSER, NOBYPASSRLS, table DML only, owns nothing.
POSTGRES_APP_USER=vantigo_app
POSTGRES_APP_PASSWORD=change-me-too

# Role the API connects as. Defaults to the least-privilege runtime role, so
# a compromised API process cannot alter the schema or act as its owner;
# migrations keep running as the owner role. Only point these at
# POSTGRES_USER for debugging.
VANTIGO_DB_USER=vantigo_app
VANTIGO_DB_PASSWORD=change-me-too

# Host port for the single Vantigo application.
VANTIGO_PORT=8080
