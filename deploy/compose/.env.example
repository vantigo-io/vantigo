# Shared settings for the Vantigo Docker Compose stack.
# Copy this file to `.env` and adjust the values.

# Image tag to run. `latest` tracks the newest release; pin a version
# (for example `v1.2.3`) for reproducible deployments.
VANTIGO_TAG=latest

# PostgreSQL owner role. It owns the schemas and runs the migration job.
POSTGRES_USER=vantigo
POSTGRES_PASSWORD=change-me

# Least-privilege runtime role created on first database initialization:
# NOSUPERUSER, NOBYPASSRLS, table DML only, owns nothing.
POSTGRES_APP_USER=vantigo_app
POSTGRES_APP_PASSWORD=change-me-too

# Role the API connects as. It defaults to the owner role above because
# tenant row-level security is not yet usable for ordinary reads: the
# `app.tenant_id` setting is only applied inside explicit transactions, so a
# role that RLS actually applies to sees no rows on normal endpoint reads.
# Do not point these at POSTGRES_APP_USER until
# https://github.com/vantigo-io/vantigo/issues/6 is fixed.
VANTIGO_DB_USER=vantigo
VANTIGO_DB_PASSWORD=change-me

# Host port for the single Vantigo application.
VANTIGO_PORT=8080
