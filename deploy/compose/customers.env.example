# Customers application settings.
# Copy this file to `customers.env` and adjust the values.
# Full reference: https://github.com/vantigo-io/vantigo/blob/main/docs/customers-authentication.md

# --- First-owner bootstrap ------------------------------------------------
# Optional. If unset, a one-time secret is generated at startup and printed
# once in the container logs (`docker compose logs customers`). Either way,
# visit /setup on the Customers app to create the first Owner account, then
# remove or rotate this secret.
# Authentication__Bootstrap__Secret=

# --- Public URLs -----------------------------------------------------------
# Templates used in invitation and password-reset emails. Point these at the
# public origin where you expose the Customers app.
Authentication__Invitations__AcceptUrl=http://localhost:8080/invitations/accept?token={token}
Authentication__PasswordReset__ResetUrl=http://localhost:8080/password-reset?email={email}&token={token}

# --- Email delivery ---------------------------------------------------------
# `Logging` (default) writes emails to the container logs — fine for trying
# things out, not for production. Set `Smtp` and fill in the server details
# to send real email.
# Email__Provider=Smtp
# Email__From=no-reply@example.com
# Email__Smtp__Host=smtp.example.com
# Email__Smtp__Port=587
# Email__Smtp__UserName=
# Email__Smtp__Password=
# Email__Smtp__EnableSsl=true

# --- Reverse proxy ----------------------------------------------------------
# When running behind a TLS-terminating reverse proxy, trust exactly that
# proxy so the forwarded scheme/host are honored.
# ForwardedHeaders__KnownProxies=10.0.0.10
# ForwardedHeaders__KnownNetworks__0=10.0.0.0/24

# --- Owner security ---------------------------------------------------------
# Require TOTP MFA for Owner accounts.
# Authentication__Owners__RequireMfa=true
