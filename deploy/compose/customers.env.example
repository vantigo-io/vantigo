# Customers application settings.
# Copy this file to `customers.env` and adjust the values.
# Full reference: https://github.com/vantigo-io/vantigo/blob/main/docs/customers-authentication.md

# --- First-owner bootstrap ------------------------------------------------
# Optional. If unset, a one-time secret is generated at startup and printed
# once in the container logs (`docker compose logs customers`). Either way,
# visit /setup on the Customers app to create the first Owner account, then
# remove or rotate this secret.
# Authentication__Bootstrap__Secret=

# --- Base path ---------------------------------------------------------------
# The app is served under this path prefix so multiple Vantigo apps can share
# one domain (e.g. https://vantigo.example.com/customers). Defaults to
# /customers. Set to an empty value to serve from the domain root.
# App__BasePath=/customers

# --- Whitelabeling -----------------------------------------------------------
# Brand the app as your own. The title replaces "Customers" in the header,
# browser tab and setup/invitation pages. The logo replaces the Vantigo logo in
# the header (any image URL; it is displayed at 32px height, width auto).
# Support contact details, when set, appear in a footer and on the sign-in page.
# App__Title=Acme CRM
# App__LogoUrl=https://cdn.example.com/logo.svg
# App__Support__Email=support@example.com
# App__Support__Phone=+47 123 45 678
# App__Support__Url=https://support.example.com

# --- Public origin -----------------------------------------------------------
# The public scheme + host users reach the app on (no path — the base path is
# configured separately). The invitation and password-reset email links are
# derived automatically from origin + base path, and the OIDC callback URI to
# register is logged at startup. Replace with your public domain in production.
App__PublicOrigin=http://localhost:8080

# --- Public URLs -----------------------------------------------------------
# Optional overrides for the mailed link templates. Only needed when the links
# should differ from App__PublicOrigin + App__BasePath + the default routes.
# Authentication__Invitations__AcceptUrl=https://vantigo.example.com/customers/invitations/accept?token={token}
# Authentication__PasswordReset__ResetUrl=https://vantigo.example.com/customers/password-reset?email={email}&token={token}

# --- Email delivery ---------------------------------------------------------
# `Logging` (default) writes emails to the container logs — fine for trying
# things out, not for production. Set `Smtp` and fill in the server details
# to send real email.
# Email__Provider=Smtp
# Email__From=no-reply@example.com
# Email__Smtp__Host=smtp.example.com
# Email__Smtp__Port=587
# Email__Smtp__UserName=
# Email__Smtp__Password=
# Email__Smtp__EnableSsl=true

# --- Reverse proxy ----------------------------------------------------------
# When running behind a TLS-terminating reverse proxy, trust exactly that
# proxy so the forwarded scheme/host are honored.
# ForwardedHeaders__KnownProxies=10.0.0.10
# ForwardedHeaders__KnownNetworks__0=10.0.0.0/24

# --- Owner security ---------------------------------------------------------
# Require TOTP MFA for Owner accounts.
# Authentication__Owners__RequireMfa=true
