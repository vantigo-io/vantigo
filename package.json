{
  "name": "vantigo",
  "description": "The development tools for typescript/javascript files used in Vantigo",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*/frontend"
    ],
    "catalog": {
      "@mantine/charts": "^9.4.2",
      "@mantine/code-highlight": "^9.4.2",
      "@mantine/core": "^9.4.2",
      "@mantine/dates": "^9.4.2",
      "@mantine/dropzone": "^9.4.2",
      "@mantine/form": "^9.4.2",
      "@mantine/hooks": "^9.4.2",
      "@mantine/modals": "^9.4.2",
      "@mantine/notifications": "^9.4.2",
      "@mantine/nprogress": "^9.4.2",
      "@mantine/spotlight": "^9.4.2",
      "@mantine/tiptap": "^9.4.2",
      "@tabler/icons-react": "^3.36.0",
      "@tanstack/react-query": "^5.90.0",
      "@tanstack/react-query-devtools": "^5.90.0",
      "@tanstack/react-router": "^1.170.18",
      "@tanstack/react-router-devtools": "^1.167.0",
      "@tanstack/router-plugin": "^1.168.23",
      "@tiptap/extension-link": "^3.28.0",
      "@tiptap/pm": "^3.28.0",
      "@tiptap/react": "^3.28.0",
      "@tiptap/starter-kit": "^3.28.0",
      "@eslint/js": "^10.0.1",
      "@types/node": "^26.1.1",
      "@types/react": "^19.2.17",
      "@types/react-dom": "^19.2.3",
      "@vitejs/plugin-react": "^6.0.4",
      "dayjs": "^1.11.21",
      "eslint": "^10.7.0",
      "eslint-plugin-react-hooks": "^7.1.1",
      "eslint-plugin-react-refresh": "^0.5.3",
      "globals": "^17.7.0",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "recharts": "^3.10.0",
      "typescript": "^6.0.3",
      "typescript-eslint": "^8.65.0",
      "vite": "^8.1.5"
    }
  },
  "scripts": {
    "prepare": "husky",
    "format:check": "biome check . && dotnet format --verify-no-changes",
    "format:write": "biome check --write . && dotnet format"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,css}": [
      "biome check --write --no-errors-on-unmatched"
    ],
    "*.cs": [
      "dotnet format --include"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "husky": "9.1.7",
    "lint-staged": "17.2.0"
  }
}
