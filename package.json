{
  "name": "vantigo",
  "description": "The development tools for typescript/javascript files used in Vantigo",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": {
    "packages": [
      "apps/*/frontend",
      "packages/*",
      "docs"
    ],
    "catalog": {
      "@fullcalendar/react": "7.1.3",
      "@mantine/charts": "^9.7.3",
      "@mantine/code-highlight": "^9.7.3",
      "@mantine/core": "^9.7.3",
      "@mantine/dates": "^9.7.3",
      "@mantine/dropzone": "^9.7.3",
      "@mantine/form": "^9.7.3",
      "@mantine/hooks": "^9.7.3",
      "@mantine/modals": "^9.7.3",
      "@mantine/notifications": "^9.7.3",
      "@mantine/nprogress": "^9.7.3",
      "@mantine/spotlight": "^9.7.3",
      "@mantine/tiptap": "^9.7.3",
      "@tabler/icons-react": "^3.49.0",
      "@tanstack/react-query": "^5.104.5",
      "@tanstack/react-query-devtools": "^5.104.5",
      "@tanstack/react-router": "^1.170.45",
      "@tanstack/react-router-devtools": "^1.167.2",
      "@tanstack/router-plugin": "^1.168.47",
      "@tiptap/extension-link": "^3.32.0",
      "@tiptap/pm": "^3.32.0",
      "@tiptap/react": "^3.32.0",
      "@tiptap/starter-kit": "^3.32.0",
      "@eslint/js": "^10.0.1",
      "@testing-library/jest-dom": "^7.0.1",
      "@testing-library/react": "^16.3.3",
      "@testing-library/user-event": "^14.6.8",
      "@types/node": "^26.6.5",
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0",
      "@vitejs/plugin-react": "^6.1.2",
      "country-flag-icons": "^1.5.21",
      "dayjs": "^1.11.23",
      "eslint": "^10.13.0",
      "eslint-plugin-react-hooks": "^7.1.1",
      "eslint-plugin-react-refresh": "^0.5.7",
      "globals": "^17.13.0",
      "i18next": "^26.5.3",
      "react-i18next": "^17.1.0",
      "react": "^19.3.1",
      "react-dom": "^19.3.1",
      "recharts": "^3.10.0",
      "temporal-polyfill": "^1.0.6",
      "typescript": "^6.0.3",
      "typescript-eslint": "^8.72.0",
      "vite": "^8.3.4",
      "vitest": "^5.0.5",
      "jsdom": "^30.1.3"
    }
  },
  "scripts": {
    "dev": "bun run --cwd apps/host/frontend dev",
    "frontend:lint": "bun run --filter '*' lint",
    "frontend:typecheck": "bun run --filter '*' typecheck",
    "frontend:test": "for d in apps/*/frontend packages/*; do bun run --cwd \"$d\" test || exit 1; done",
    "frontend:build": "bun run --cwd apps/host/frontend build",
    "gen:client": "bun run tools/openapi/gen-client.ts",
    "gen:client:test": "bun test tools/openapi",
    "translations:check": "bun run tools/i18n/check.ts",
    "i18n:test": "bun run --cwd apps/customers/frontend vitest run --root ../../../packages/frontend-shell src/i18n && bun test tools/i18n",
    "prepare": "husky",
    "format:check": "biome check .",
    "format:write": "biome check --write .",
    "docs:check": "bun run tools/docs/check-coverage.ts",
    "docs:test": "bun test tools/docs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "husky": "9.1.7",
    "openapi-typescript": "7.13.0"
  },
  "overrides": {
    "brace-expansion": "^5.0.12",
    "undici": "^7.30.1",
    "nanoid": "^3.3.20",
    "form-data": "^4.0.6",
    "source-map-js": "^1.2.2",
    "prosemirror-view": "^1.42.6",
    "zod": "^4.6.7"
  }
}
