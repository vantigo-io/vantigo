{
  "name": "vantigo",
  "description": "The development tools for typescript/javascript files used in Vantigo",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": {
    "packages": [
      "apps/*/frontend",
      "packages/*"
    ],
    "catalog": {
      "@mantine/charts": "^9.4.2",
      "@mantine/code-highlight": "^9.4.2",
      "@mantine/core": "^9.4.2",
      "@mantine/dates": "^9.4.2",
      "@mantine/dropzone": "^9.4.2",
      "@mantine/form": "^9.4.2",
      "@mantine/hooks": "^9.4.2",
      "@mantine/modals": "^9.4.2",
      "@mantine/notifications": "^9.4.2",
      "@mantine/nprogress": "^9.4.2",
      "@mantine/spotlight": "^9.4.2",
      "@mantine/tiptap": "^9.4.2",
      "@tabler/icons-react": "^3.36.0",
      "@tanstack/react-query": "^5.90.0",
      "@tanstack/react-query-devtools": "^5.90.0",
      "@tanstack/react-router": "^1.170.18",
      "@tanstack/react-router-devtools": "^1.167.0",
      "@tanstack/router-plugin": "^1.168.23",
      "@tiptap/extension-link": "^3.28.0",
      "@tiptap/pm": "^3.28.0",
      "@tiptap/react": "^3.28.0",
      "@tiptap/starter-kit": "^3.28.0",
      "@eslint/js": "^10.0.1",
      "@testing-library/jest-dom": "^6.9.1",
      "@testing-library/react": "^16.3.0",
      "@testing-library/user-event": "^14.6.1",
      "@types/node": "^26.1.1",
      "@types/react": "^19.2.17",
      "@types/react-dom": "^19.2.3",
      "@vitejs/plugin-react": "^6.0.4",
      "country-flag-icons": "^1.5.21",
      "dayjs": "^1.11.21",
      "eslint": "^10.7.0",
      "eslint-plugin-react-hooks": "^7.1.1",
      "eslint-plugin-react-refresh": "^0.5.3",
      "globals": "^17.7.0",
      "i18next": "^25.6.2",
      "react-i18next": "^16.0.1",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "recharts": "^3.10.0",
      "typescript": "^6.0.3",
      "typescript-eslint": "^8.65.0",
      "vite": "^8.1.5",
      "vitest": "^4.0.0",
      "jsdom": "^28.0.0"
    }
  },
  "scripts": {
    "frontend:lint": "bun run --cwd apps/customers/frontend lint && bun run --cwd apps/communications/frontend lint && bun run --cwd apps/products/frontend lint && bun run --cwd apps/energy/frontend lint && bun run --cwd apps/host/frontend lint",
    "frontend:test": "bun run --cwd packages/frontend-api-client test && bun run --cwd packages/frontend-shell test && bun run --cwd apps/customers/frontend test && bun run --cwd apps/communications/frontend test && bun run --cwd apps/products/frontend test && bun run --cwd apps/energy/frontend test && bun run --cwd apps/host/frontend test",
    "frontend:build": "bun run --cwd apps/host/frontend build",
    "toolchain:check": "bun run tools/toolchain/check.ts",
    "translations:check": "bun run tools/i18n/check.ts",
    "i18n:test": "bun run --cwd apps/customers/frontend vitest run --root ../../../packages/frontend-shell src/i18n && bun test tools/i18n",
    "prepare": "husky",
    "format:check": "biome check . && dotnet format \"Vantigo.slnx\" --verify-no-changes --no-restore",
    "format:write": "biome check --write . && dotnet format"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "husky": "9.1.7"
  },
  "overrides": {
    "brace-expansion": "^5.0.9",
    "nanoid": "^3.3.18"
  }
}
